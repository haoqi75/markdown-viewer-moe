{
  "name": "markdown-viewer-moe",
  "version": "1.10.5",
  "description": "由AI生成的Moe Markdown查看器",
  "scripts": {
    "build": "run-s build:page build:tools build:404",
    "build:page": "gulp build",
    "build:release": "run-s build:page && node scripts/release.js",
    "build:tools": "pnpm run --filter moe-json-editor build:html && node scripts/copy-tools.js",
    "build:404": "node scripts/build-404.js",
    "postbuild": "",
    "dev": "gulp",
    "dev:tools": "pnpm run --filter moe-json-editor dev",
    "start": "gulp"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "clean-css": "^5.3.3",
    "del": "^7.1.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-inline": "^0.1.3",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-uglify": "^3.0.2",
    "npm-run-all2": "^9.0.2",
    "uglify-js": "^3.19.3"
  },
  "workspaces": [
    "tools"
  ],
  "dependencies": {
    "jimp": "^1.6.1"
  }
}