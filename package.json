{
  "name": "markdown-viewer-moe",
  "version": "2.0.0-rc.0",
  "description": "由AI生成的Moe Markdown查看器",
  "homepage": "https://moe520.cc.cd/",
  "keywords": [
    "ai",
    "gulp",
    "html",
    "markdown"
  ],
  "bugs": {
    "url": "https://github.com/haoqi75/markdown-viewer-moe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoqi75/markdown-viewer-moe.git"
  },
  "license": "MIT",
  "author": "haoqi75",
  "type": "module",
  "main": "server.js",
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "dev": "vite --config vite.config.ts",
    "build": "vite build",
    "build:release": "vite build && gulp release",
    "build:tools": "pnpm run --filter moe-json-editor build:html && node scripts/copy-tools.js && node scripts/minify-html.js tools.html",
    "build:tools-release": "pnpm run --filter moe-json-editor build:html && node scripts/copy-tools.js --release && node scripts/minify-html.js tools-v*.html",
    "build:docs": "vitepress build docs",
    "dev:tools": "pnpm run --filter moe-json-editor dev",
    "dev:docs": "vitepress dev docs",
    "lint:tools": "pnpm --filter moe-json-editor lint",
    "start": "node .",
    "preview:docs": "vitepress preview docs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "html-minifier-terser": "^7.2.0",
    "pagefind": "^1.6.0",
    "vue": "^3.5.45",
    "vitepress-plugin-pagefind": "^0.4.27"
  },
  "devDependencies": {
    "@catppuccin/vitepress": "^0.1.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "gulp": "^5.0.1",
    "sass": "^1.108.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-theme-sakura": "^0.5.1"
  }
}
